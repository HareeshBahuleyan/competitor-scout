# Application
ENVIRONMENT=local
PUBLIC_BASE_URL=http://localhost:3000
WEB_INTERNAL_API_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql+asyncpg://competitor_scout:competitor_scout@localhost:5432/competitor_scout

# Authentication and sessions
SESSION_COOKIE_NAME=competitor_scout_session
SESSION_SECRET=replace-with-at-least-32-random-bytes
CSRF_SECRET=replace-with-at-least-32-random-bytes

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Otari AI gateway
OTARI_BASE_URL=https://api.otari.ai
OTARI_AI_TOKEN=
OTARI_MAIN_MODEL=competitor-scout-main
OTARI_CHILD_MODEL=competitor-scout-child

# Product and finding limits
MAX_ACTIVE_USERS=10
MAX_ACTIVE_COMPETITORS=10
FINDING_CONFIDENCE_THRESHOLD=0.70

# Agent orchestration
MAX_CHILD_TASKS_PER_RUN=8
MAX_CONCURRENT_CHILD_TASKS=4
MAX_CHILD_SEARCH_CALLS=2
MAX_SOURCE_DISCOVERY_SEARCH_CALLS=5
MAX_OTARI_CONCURRENCY=8
MAX_PLANNING_REPAIRS=1
MAX_SYNTHESIS_REPAIRS=1
MAX_CHILD_RETRIES=1

# Model token limits
MAIN_INPUT_TOKEN_LIMIT=32000
MAIN_OUTPUT_TOKEN_LIMIT=4000
CHILD_INPUT_TOKEN_LIMIT=16000
CHILD_OUTPUT_TOKEN_LIMIT=3000

# Execution deadlines
PLANNING_DEADLINE_SECONDS=60
CHILD_DEADLINE_SECONDS=120
SYNTHESIS_DEADLINE_SECONDS=90

# Cost controls and estimates
MAX_RUN_COST_USD=2.25
MAX_USER_DAILY_COST_USD=5.00
ESTIMATED_MAIN_REQUEST_COST_USD=0.20
ESTIMATED_CHILD_REQUEST_COST_USD=0.10

# Test-only authentication
E2E_AUTH_SECRET=
